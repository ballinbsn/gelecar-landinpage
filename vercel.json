{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(assets|img|__l5e)/(.*)\.(png|webp|gif|svg|woff|woff2|jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
